# Copy this file to secrets.yaml (in your ESPHome config folder) and fill in your own values.
# secrets.yaml is listed in .gitignore and must never be committed.
wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"
# Generate with: openssl rand -base64 32   (or let the ESPHome dashboard create one)
api_key: "REPLACE_WITH_BASE64_KEY"
